# Request throttling. /api/checkout reserves stock for an hour before payment is captured,
# so it has a tighter per-IP limit than the global one. Raise these only with a deliberate
# decision; they are the only guard against stock being held without payment.
RATE_LIMIT_MAX=600
RATE_LIMIT_CHECKOUT_MAX=20
RATE_LIMIT_PUBLIC_FORM_MAX=10

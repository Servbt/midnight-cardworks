generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending_payment
  paid
  fulfilled
  canceled
  refund_pending
  partially_refunded
  refunded
  refund_failed
}

enum MarketingSubscriberStatus {
  subscribed
  unsubscribed
}

model Product {
  id          String   @id
  slug        String   @unique
  title       String
  description String
  price       Int
  saleActive  Boolean  @default(false)
  salePrice   Int?
  category    String
  tags        String[]
  image       String
  reservedInventory Int @default(0)
  inventoryVersion Int @default(0)
  inventory   Int
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id        String      @id
  email           String
  receiptTokenHash String?
  customerName    String?
  shippingAddress String?
  subtotal        Int
  shippingCost    Int         @default(0)
  total                 Int
  status                OrderStatus @default(pending_payment)
  stripeSessionId       String?
  stripePaymentIntentId String?
  stripeRefundId        String?
  discountAmount        Int         @default(0)
  paidAt                DateTime?
  fulfilledAt           DateTime?
  refundedAmount        Int         @default(0)
  refundReason          String?
  canceledAt            DateTime?
  refundedAt            DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  inventoryState String @default("legacy")
  reservationExpiresAt DateTime?
  inventoryIssue String?

  items OrderItem[]
  @@index([inventoryState, reservationExpiresAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  title     String
  price     Int
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model MarketingSubscriber {
  id               String                    @id
  email            String                    @unique
  name             String?
  status           MarketingSubscriberStatus @default(subscribed)
  source           String                    @default("storefront_coupon")
  couponCode       String
  unsubscribeToken String                    @unique
  consentedAt      DateTime                  @default(now())
  unsubscribedAt   DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
}
model FaqItem {
  id        String   @id
  question  String
  answer    String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String    @id
  slug        String    @unique
  title       String
  excerpt     String
  body        String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Durable event IDs, individual refunds, API operations and notification jobs.
// Prefix-qualified IDs are unique across all instances. Changes share the order transaction.
model PaymentJournal {
  id        String   @id
  kind      String
  orderId   String?
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, orderId])
}

{
  "private": true,
  "type": "module",
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace @midnight-cardworks/api",
    "dev:web": "npm run dev --workspace @midnight-cardworks/web",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "start": "node apps/api/dist/index.js",
    "render:build": "npm run db:generate && npm run build && npm run db:migrate",
    "db:generate": "npm run db:generate --workspace @midnight-cardworks/api",
    "db:migrate": "npm run db:migrate --workspace @midnight-cardworks/api",
    "db:dev": "npm run db:dev --workspace @midnight-cardworks/api"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
